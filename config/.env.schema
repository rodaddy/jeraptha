# OpenClaw Environment Schema
# Varlock @env-spec - https://varlock.dev/env-spec
#
# This schema is the SINGLE SOURCE OF TRUTH for all OpenClaw env vars.
# Safe to commit to git -- actual secrets are resolved at runtime via fetch-secrets.sh.
# AI agents see this schema (structure/types) but NEVER the resolved values.
#
# Usage:
#   varlock load              -- validate all variables
#   varlock run ./start.sh    -- inject vars and run
#   varlock scan              -- check for leaked secrets in codebase
#
# @defaultRequired=true @defaultSensitive=false
# @redactLogs=true
# @preventLeaks=true
# @generateTypes(lang=ts, path=env.d.ts)
# @setValuesBulk(exec(`./fetch-secrets.sh`), format=env)
# ----------

# ============================================================================
# POSTGRESQL (CT 200 - <LITELLM_HOST>)
# ============================================================================

# n8n database connection
# @type=string
POSTGRES_HOST=<LITELLM_HOST>

# @type=number
POSTGRES_PORT=5432

# @type=string
POSTGRES_N8N_USER=n8nops

# @sensitive
POSTGRES_N8N_PASSWORD=

# @type=string
POSTGRES_N8N_DB=n8n

# Second Brain / Clawdbot database
# @type=string
POSTGRES_CLAWDBOT_USER=clawdbot

# @sensitive
POSTGRES_CLAWDBOT_PASSWORD=

# @type=string
POSTGRES_CLAWDBOT_DB=secondbrain

# Full connection strings -- TODO: create vault items or compose at startup
# @sensitive @type=string @optional
POSTGRES_CLAWDBOT_URL=

# @sensitive @type=string @optional
DATABASE_URL=

# ============================================================================
# N8N WORKFLOW ENGINE (CT 202 - <N8N_HOST>)
# ============================================================================

# @type=string
N8N_HOST=0.0.0.0

# @type=number
N8N_PORT=5678

# @type=string
N8N_PROTOCOL=https

# @type=url
N8N_URL=https://n8n.example.com

# @type=url
N8N_WEBHOOK_URL=https://n8n.example.com/webhook

# @type=string
N8N_BASIC_AUTH_USER=admin

# @sensitive
N8N_BASIC_AUTH_PASSWORD=

# @sensitive
N8N_ENCRYPTION_KEY=

# n8n credential reference IDs (not secrets -- safe for agents)
# @type=string @optional
N8N_POSTGRES_CREDENTIAL_ID=sb-postgres-01

# ============================================================================
# LITELLM PROXY (CT 204 - <LITELLM_HOST>)
# ============================================================================

# @type=url
LITELLM_PROXY_URL=http://<LITELLM_HOST>:4000

# @sensitive
LITELLM_API_KEY=

# @type=url
LITELLM_BASE_URL=http://<LITELLM_HOST>:4000

# Model aliases -- config, not secrets
# @type=string
LITELLM_MODEL_MAIN=main

# @type=string
LITELLM_MODEL_FAST=fast

# @type=string
LITELLM_MODEL_QUALITY=quality

# @type=string
LITELLM_MODEL_FLASH=flash

# @type=string
LITELLM_MODEL_PRO=pro

# @type=string
LITELLM_MODEL_EMBEDDINGS=text-embedding-004

# ============================================================================
# AI MODEL BACKENDS (Vertex AI / Google Cloud)
# ============================================================================

# Path to VertexAI service account JSON
# @sensitive @type=string
GOOGLE_APPLICATION_CREDENTIALS=/mnt/truenas/credentials/vertex_ai_creds.json

# @type=string
ANTHROPIC_VERTEX_PROJECT_ID=<GCP_PROJECT_ID>

# @type=string
CLOUD_ML_REGION=us-east5

# Model version strings
# @type=string
ANTHROPIC_MODEL=claude-sonnet-4-6

# @type=string
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6

# @type=string
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5@20251001

# @type=string
GOOGLE_GEMINI_PRO=gemini-3-pro-preview

# @type=string
GOOGLE_GEMINI_FLASH=gemini-3-flash-preview

# @type=string
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Direct API keys (only needed if bypassing LiteLLM)
# @sensitive @optional
GEMINI_API_KEY=

# @sensitive @optional
ANTHROPIC_API_KEY=

# ============================================================================
# SIYUAN KNOWLEDGE BASE (CT 203 - <SIYUAN_HOST>)
# ============================================================================

# @type=url
SIYUAN_INTERNAL_URL=http://<SIYUAN_HOST>:6806

# @type=url
SIYUAN_EXTERNAL_URL=https://siyuan.example.com

# @type=string
SIYUAN_HOST=<SIYUAN_HOST>

# @type=number
SIYUAN_PORT=6807

# @sensitive
SIYUAN_TOKEN=

# TODO: create vault item or merge into "SiYuan Token"
# @sensitive @optional
SIYUAN_ACCESS_AUTH_CODE=

# Notebook IDs -- structural references, not secrets
# @type=string
SIYUAN_NOTEBOOK_PEOPLE=20260125220607-bvsw1yh

# @type=string
SIYUAN_NOTEBOOK_PROJECTS=20260125220607-7m05da9

# @type=string
SIYUAN_NOTEBOOK_IDEAS=20260125220607-qytzf2k

# @type=string
SIYUAN_NOTEBOOK_ADMIN=20260125220607-qhcifwd

# ============================================================================
# CLAWDBOT / DISCORD (CT 204 - <LITELLM_HOST>)
# ============================================================================

# @type=string
CLAWDBOT_HOST=<LITELLM_HOST>

# @type=number
CLAWDBOT_PORT=18789

# @type=number
CLAWDBOT_WEBHOOK_PORT=18788

# @sensitive
CLAWDBOT_AUTH_TOKEN=

# @sensitive
DISCORD_BOT_TOKEN=

# TODO: create vault item or store in discord.com entry
# @type=string @optional
DISCORD_GUILD_ID=

# Discord webhook URLs for channel routing
# @sensitive @optional
DISCORD_DIGEST_WEBHOOK=

# @sensitive @optional
DISCORD_NEEDS_REVIEW_WEBHOOK=

# @sensitive @optional
DISCORD_SKIPPY_INBOX_WEBHOOK=

# ============================================================================
# CLAWDBOT-MCP SERVER
# ============================================================================

# @type=number
CLAWDBOT_MCP_PORT=3001

# ============================================================================
# MONITORING (CT 201 - <MONITORING_HOST>)
# ============================================================================

# @type=url
PROMETHEUS_URL=http://<MONITORING_HOST>:9090

# @type=url
PROMETHEUS_EXTERNAL_URL=https://prometheus.example.com

# @type=url
GRAFANA_URL=http://<MONITORING_HOST>:3000

# @type=url
GRAFANA_EXTERNAL_URL=https://grafana.example.com

# @type=string
GRAFANA_ADMIN_USER=admin

# @sensitive
GRAFANA_ADMIN_PASSWORD=

# @sensitive
GRAFANA_API_KEY=

# ============================================================================
# MESSAGING INTEGRATIONS
# ============================================================================

# @sensitive @optional
TELEGRAM_BOT_TOKEN=

# @type=string @optional
TELEGRAM_USER_ID=

# @type=string @optional
IMESSAGE_RECIPIENT=

# ============================================================================
# MEDIA AUTOMATION (optional)
# ============================================================================

# @type=url @optional
RADARR_URL=http://<YOUR_IP>:7878

# @sensitive @optional
RADARR_API_KEY=

# @type=url @optional
SONARR_URL=http://<YOUR_IP>:8989

# @sensitive @optional
SONARR_API_KEY=

# ============================================================================
# STORAGE & BACKUP
# ============================================================================

# @type=string
TRUENAS_NFS_HOST=<NAS_HOST>

# @type=string
TRUENAS_NFS_PATH=/mnt/big_pool/apps/second-brain

# ============================================================================
# SERVICE URLs (external access)
# ============================================================================

# @type=url
PAI_URL=https://pai.example.com

# @type=url
SIYUAN_URL=https://siyuan.example.com
